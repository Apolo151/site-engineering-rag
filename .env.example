# OpenAI-compatible endpoint used for the generation step (Part C, step 7).
# Defaults target Groq's free-tier API; swap for any OpenAI-compatible provider
# (OpenRouter, local Ollama, etc.) by changing the base URL.

OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# Falls back to GROQ_API_KEY if OPENAI_API_KEY is unset.
GROQ_API_KEY=

RAG_MODEL=openai/gpt-oss-120b

# Web GUI (`uv run rag-web`) bind address - optional overrides.
# RAG_WEB_HOST=127.0.0.1
# RAG_WEB_PORT=8000
